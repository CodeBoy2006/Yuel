{
  "name": "yuel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first reading analytics browser extension.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:headed": "pnpm build && playwright test --headed",
    "test:browser:install": "playwright install chromium",
    "test:browser-dom": "vitest run --config vitest.browser-dom.config.ts",
    "test:stress:large-text": "vitest run --config vitest.large-text-stress.config.ts",
    "test:real-pages": "YUEL_REAL_PAGE_CORPUS=1 vitest run --config vitest.real-pages.config.ts",
    "test:extension-browser-smoke": "pnpm build && playwright test tests/e2e/extension.spec.ts",
    "test:extension-smoke": "pnpm build && vitest run --config vitest.smoke.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "html-to-image": "1.11.13",
    "lucide-react": "1.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "wxt": "0.20.27"
  },
  "packageManager": "pnpm@11.7.0"
}
